"""
Read mapping + InStrain pipeline for one MAG set (e.g. all MAGs assembled from site M5 at 3 cmbsf)
against the reads from every sediment depth of the same site.

Steps (one run per MAG set; settings in config.yaml):
  1. trim reads (fastp)
  2. concatenate the MAGs into one reference + scaffold-to-bin (.stb) file
  3. predict genes (prodigal), annotate (eggNOG-mapper, MMseqs2 vs UniRef90)
  4. map reads (bwa mem) and run a first InStrain profile ("IS_raw_*")
  5. keep only the reads InStrain used, normalise coverage between depths gene by gene
     (normalize_paired_regions, https://github.com/Winshipe/Normalise-Paired-Regions)
  6. run a second InStrain profile on the normalised reads ("IS_proc_*")

Run from this folder, e.g. on a SLURM cluster:
    snakemake --use-conda --cores 32
    snakemake --use-conda --config mag_origin=M1_3 site=M1   # override config values

Expected input layout (relative to the working directory):
    refs/{mag_origin}.{mag}.filtered.fa      one fasta per MAG
    raw_reads/{site}_{depth}_R1.fastq.gz     paired reads per sediment depth
    raw_reads/{site}_{depth}_R2.fastq.gz
"""
import json
import os

#note that here "depth" ALWAYS refers to sample depth (Cm Below Sea Floor) rather than
#depth of coverage!  I (and instrain) use "coverage" when talking about depth of coverage

configfile: "config.yaml"

mag_origin = config["mag_origin"]   # MAG set, e.g. "M5_3" = site M5, assembled from 3 cmbsf
my_site = config["site"]            # site the reads come from, e.g. "M5"
mag_numbers = config["mag_numbers"][mag_origin]  # MAG ids within the set (M5_3.<id>.filtered.fa)
my_depths = config["depths"]        # read depths (cmbsf)

rule all:
    input:
        expand(
            ["refs/{mag_origin}.{mag}.filtered.fa",
             "trimmed/trimmed_{site}_{depth}_R1.fastq",
            "trimmed/trimmed_{site}_{depth}_R2.fastq",
            "combined_reference_{mag_origin}.fa",
            "combined_reference_{mag_origin}.stb",
            "combined_reference_{mag_origin}.fna",
            "combined_reference_{mag_origin}_uniref_hits",
            "annotations/{mag_origin}.{mag}_eggnog.emapper.annotations",
            "regions_{mag_origin}.tsv",
            "bams/normalized_filtered_{mag_origin}_{depth}.bam",
            "bams/processed_{mag_origin}_{depth}.bam",
            "IS_proc_{mag_origin}_{depth}/output/IS_proc_{mag_origin}_{depth}_genome_info.tsv"],
            site = [my_site],
            mag_origin = [mag_origin],
            depth = my_depths,
            mag = mag_numbers,
            allow_missing = True
        )


# concatenate all MAGs into one reference and record which scaffold belongs to which MAG
rule combine_references:
    input:
        refs = expand(["refs/{s}.{m}.filtered.fa"], s=mag_origin, m = mag_numbers)
    output:
        comb_fa = "combined_reference_{mag_origin}.fa",
        stb = "combined_reference_{mag_origin}.stb"
    shell: """
        for f in {input.refs}
        do
        grep '>' $f | awk ' {{ gsub(">","") ; print $1 "\t" "'$f'" }} ' >> {output.stb}
        cat $f >> {output.comb_fa}
        done
    """

rule trim:
    input:
        R1 = "raw_reads/{site}_{depth}_R1.fastq.gz",
        R2 = "raw_reads/{site}_{depth}_R2.fastq.gz",
    output:
        R1 = "trimmed/trimmed_{site}_{depth}_R1.fastq",
        R2 = "trimmed/trimmed_{site}_{depth}_R2.fastq"
    conda:
        "envs/main.yaml"
    shell: """
        mkdir -p trimmed
        fastp -i {input.R1} -I {input.R2} -o {output.R1} -O {output.R2}
    """

rule gene_annotations:
    input:
        ref = "refs/{mag_origin}.{mag}.filtered.fa"
    output:
        out = "annotations/{mag_origin}.{mag}_eggnog.emapper.annotations",
        fna = "annotations/{mag_origin}.{mag}_eggnog.emapper.genepred.fasta"
    params:
        eggnog_db = config["eggnog_data_dir"]
    resources:
            cpus_per_task= 24,
            mem_mb= 32000
    conda:
        "envs/eggnog.yaml"
    shell: """
        emapper.py --cpu {resources.cpus_per_task} --itype genome -i {input.ref} --data_dir {params.eggnog_db} --output annotations/$(basename {input.ref} .filtered.fa)_eggnog
    """

# gene prediction on the combined reference; .faa (amino acids) is used to count synonymous /
# non-synonymous sites per gene, .fna is used by InStrain
rule prodigal:
    input:
        comb_fa = "combined_reference_{mag_origin}.fa",
    output:
        comb_genes = "combined_reference_{mag_origin}.fna",
        comb_genes_aa = "combined_reference_{mag_origin}.faa"
    conda:
        "envs/main.yaml"
    shell: """
        prodigal -a {output.comb_genes_aa} -d {output.comb_genes} -i {input.comb_fa}
    """

# UniRef90 annotation; the output is data/annotations/uniref_hits_<mag_origin>.tsv in the analysis
rule mmseqs_uniref:
    input:
        comb_fna = "combined_reference_{mag_origin}.fna"
    output:
        out = "combined_reference_{mag_origin}_uniref_hits"
    params:
        uniref_db = config["uniref90_mmseqs_db"],
        tmp_dir = config["tmp_dir"]
    resources:
        cpus_per_task = 48,
        mem_mb = 164000
    conda:
        "envs/main.yaml"
    shell: """
        mmseqs easy-search --split-memory-limit 164G --threads {resources.cpus_per_task} {input.comb_fna} {params.uniref_db} {output.out} {params.tmp_dir}/mmseqs_{wildcards.mag_origin}
    """

rule bwa_index_mags:
    input:
        comb_fa = "combined_reference_{mag_origin}.fa",
    output:
        comb_fa_index = "combined_reference_{mag_origin}.fa.pac",
    conda:
        "envs/main.yaml"
    shell:"""
    bwa index {input.comb_fa}
    """

rule first_read_mapping:
    input:
        comb_fa = "combined_reference_{mag_origin}.fa",
        comb_fa_index = "combined_reference_{mag_origin}.fa.pac",
        R1 = "trimmed/trimmed_" + my_site + "_{depth}_R1.fastq",
        R2 = "trimmed/trimmed_" + my_site + "_{depth}_R2.fastq"
    output:
        sam = "bams/temp_{mag_origin}_{depth}.sam"
    resources:
        cpus_per_task = 16,
        mem_mb = 16000
    conda:
        "envs/main.yaml"
    shell: """
        bwa mem -t {resources.cpus_per_task} {input.comb_fa} {input.R1} {input.R2} > {output.sam}
    """

rule sort_sam_file:
    input:
        sam = "bams/temp_{mag_origin}_{depth}.sam"
    output:
        bam = "bams/raw_{mag_origin}_{depth}.bam"
    resources:
        mem_mb = 8000,
        cpus_per_task = 4,
    conda:
        "envs/main.yaml"
    shell: """
        samtools sort -o {output.bam} -O BAM -@ {resources.cpus_per_task} {input.sam} &&
        rm {input.sam}
    """

# first InStrain pass on all mapped reads ("raw"); its SNV / gene / genome tables are what the
# R analysis uses (data/all_depths_*/IS_raw_*)
rule first_instrain:
    input:
        comb_fa = "combined_reference_{mag_origin}.fa",
        bam = "bams/raw_{mag_origin}_{depth}.bam",
        stb = "combined_reference_{mag_origin}.stb",
        comb_genes = "combined_reference_{mag_origin}.fna"
    params:
        isdir = "IS_raw_{mag_origin}_{depth}"
    output:
        output = "IS_raw_{mag_origin}_{depth}/output/IS_raw_{mag_origin}_{depth}_genome_info.tsv",
        rdic = "IS_raw_{mag_origin}_{depth}/raw_data/Rdic.json",
    conda:
        "envs/main.yaml"
    resources:
        cpus_per_task = 32,
        mem_mb = 128000
    shell: """
       inStrain profile -p {resources.cpus_per_task} -s {input.stb} -g {input.comb_genes} -o {params.isdir} {input.bam} {input.comb_fa}
    """

# keep only the reads that passed InStrain's filters (read names are listed per scaffold in Rdic.json)
rule filter_qnames:
    input:
        Rdic = "IS_raw_{mag_origin}_{depth}/raw_data/Rdic.json",
        stb = "combined_reference_{mag_origin}.stb",
        bam = "bams/raw_{mag_origin}_{depth}.bam",
    output:
        filtered = "bams/filtered_{mag_origin}_{depth}.bam",
    conda:
        "envs/main.yaml"
    run:
        qnames = f"{my_site}_{wildcards.depth}_qnames.txt"
        with open(input.Rdic) as f:
            my_json = json.load(f)

        with open(input.stb) as f:
            contigs = [line.strip().split("\t")[0] for line in f]

        with open(qnames,"w") as f:
            for ctg in contigs:
                try:
                    for qname in set(q.split(" ")[0] for q in my_json[ctg].keys()):
                        f.write(qname)
                        f.write("\n")
                except KeyError as e:
                    print(ctg) # scaffold with no passing reads
        os.system(f"samtools view -N {qnames} -O BAM -o {output.filtered} {input.bam}")

# one line per prodigal gene ("contig:start-end"), repeated once per BAM, as input for the normaliser
rule find_regions:
    input:
        comb_fna = "combined_reference_{mag_origin}.fna"
    output:
        regions = "regions_{mag_origin}.tsv"
    run:
        region_list = []
        with open(input.comb_fna) as f:
            for line in f:
                if line[0] == ">":
                    # prodigal header: >contig_12_3 # start # end # strand # info
                    ctg, start, end, direction, extra = line[1:-1].replace(" ","").split("#")
                    ctg = "_".join(ctg.strip().split("_")[:-1]) # drop the gene number to get the contig
                    reg = f"{ctg}:{start}-{end}"
                    region_list.append(reg)
        with open(output.regions, "w") as f:
            for reg in region_list:
                f.write("\t".join([reg for i in range(len(my_depths))])+"\n") # repeat the region as many times as there are bams

# subsample reads so every gene has the same coverage in every depth's BAM
rule normalize:
    input:
        filtered_bams = expand(["bams/filtered_{mo}_{d}.bam"], mo=mag_origin, d=my_depths),
        regions = f"regions_{mag_origin}.tsv"
    output:
        expand(["bams/normalized_filtered_{mo}_{d}.bam"], mo=mag_origin, d=my_depths)
    params:
        normalizer = config["normalize_paired_regions_bin"]
    shell: """
        {params.normalizer} -r {input.regions} --bams {input.filtered_bams} && touch normalize_done.txt
    """

rule sort_and_index_normalized:
    input:
        normalized_bam = "bams/normalized_filtered_{mag_origin}_{depth}.bam"
    output:
        proc_bam = "bams/processed_{mag_origin}_{depth}.bam"
    conda:
        "envs/main.yaml"
    shell: """
        samtools sort -o {output.proc_bam} -O BAM {input.normalized_bam}
    """

# second InStrain pass on the coverage-normalised reads ("proc")
rule second_pass_instrain:
    input:
        proc_bam = "bams/processed_{mag_origin}_{depth}.bam",
        stb = "combined_reference_{mag_origin}.stb",
        comb_genes = "combined_reference_{mag_origin}.fna",
        comb_fa = "combined_reference_{mag_origin}.fa"
    output:
        is_out_dir = directory("IS_proc_{mag_origin}_{depth}"),
        output = "IS_proc_{mag_origin}_{depth}/output/IS_proc_{mag_origin}_{depth}_genome_info.tsv"
    resources:
        cpus_per_task = 48,
        mem_mb = 64000
    conda:
        "envs/main.yaml"
    shell: """
       inStrain profile --skip_plot_generation -p {resources.cpus_per_task} -s {input.stb} -g {input.comb_genes} -o {output.is_out_dir} {input.proc_bam} {input.comb_fa}
    """
